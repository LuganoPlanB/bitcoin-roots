{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bitcoin Roots immutable candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest",
    "scoped_tree_digest",
    "manifest_revision",
    "manifest_digest",
    "immutable_inputs",
    "expected_unit_ids",
    "finalized_at",
    "produced_at",
    "unit_outcomes",
    "approvals",
    "invariants",
    "build_test_platform_matrix",
    "generated_outputs",
    "compatibility_migration",
    "reproducibility",
    "performance_resources",
    "limitations",
    "security_review",
    "release_approval",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_digest": {
      "$ref": "#/$defs/digest"
    },
    "scoped_tree_digest": {
      "$ref": "#/$defs/digest"
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "finalized_at": {
      "$ref": "#/$defs/timestamp"
    },
    "produced_at": {
      "$ref": "#/$defs/timestamp"
    },
    "release_approval": {
      "const": false
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "immutable_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "expected_unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "unit_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "build_test_platform_matrix": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "generated_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "compatibility_migration": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "reproducibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "performance_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/performanceArtifact"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "security_review": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "manifest",
            "materials",
            "plan"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "candidate_digest",
        "scoped_tree_digest",
        "manifest_digest",
        "fixture_digest",
        "artifact_digest",
        "finished_at",
        "command",
        "test_identity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "pass"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "scoped_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "fixture_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "command": {
          "$ref": "#/$defs/id"
        },
        "test_identity": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "candidate_digest",
        "scoped_tree_digest",
        "manifest_digest",
        "evidence_digest",
        "produced_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "scoped_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "produced_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "candidate_digest",
        "scoped_tree_digest",
        "manifest_digest",
        "fixture_digest",
        "artifact_digest",
        "finished_at",
        "command",
        "test_identity",
        "expectation_scope",
        "responsible_adaptation_id",
        "core_knots_differential_digest",
        "policy_block_acceptance_digest"
      ],
      "properties": {
        "id": {
          "enum": [
            "no-rdts-bip110-enforcement",
            "core-valid-block-acceptance",
            "policy-rejection-block-acceptance",
            "conservative-configurable-defaults",
            "knots-compatibility",
            "startup-help-config",
            "roots-feature-regression"
          ]
        },
        "status": {
          "const": "pass"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "scoped_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "fixture_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "command": {
          "$ref": "#/$defs/id"
        },
        "test_identity": {
          "$ref": "#/$defs/id"
        },
        "expectation_scope": {
          "enum": ["core-knots-shared", "roots-specific"]
        },
        "responsible_adaptation_id": {
          "$ref": "#/$defs/id"
        },
        "core_knots_differential_digest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "policy_block_acceptance_digest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "status",
        "candidate_digest",
        "scoped_tree_digest",
        "manifest_digest",
        "artifact_digest",
        "limitation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "approved-limitation"
          ]
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "scoped_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "limitation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "approval_id",
                "approval_digest"
              ],
              "properties": {
                "reason": {
                  "$ref": "#/$defs/id"
                },
                "approval_id": {
                  "$ref": "#/$defs/id"
                },
                "approval_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_digest",
        "scoped_tree_digest",
        "manifest_digest",
        "artifact_digest",
        "summary",
        "produced_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "scoped_tree_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "summary": {
          "$ref": "#/$defs/id"
        },
        "produced_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "performanceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidate_digest", "scoped_tree_digest", "manifest_digest", "artifact_digest", "baseline", "result", "explanation", "produced_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "scoped_tree_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "baseline": {"$ref": "#/$defs/id"},
        "result": {"$ref": "#/$defs/id"},
        "explanation": {"$ref": "#/$defs/id"},
        "produced_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
