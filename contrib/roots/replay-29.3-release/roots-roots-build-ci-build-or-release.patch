+              awk -F: '$1 == "fpr" { print $10; exit }'
+          )"
+          if [[ "$secret_fingerprint" != "$EXPECTED_FINGERPRINT" ]]; then
+            printf 'The configured secret key does not match the release public key\n' >&2
+            exit 1
+          fi
