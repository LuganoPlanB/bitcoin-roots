+            printf 'Expected %s release assets, found %s\n' \
+              "$((EXPECTED_PACKAGE_COUNT + 2))" "${#release_assets[@]}" >&2
+            exit 1
+          fi
+          gh release create "$GITHUB_REF_NAME" \
+            "${release_options[@]}" \
+            "${release_assets[@]}"
