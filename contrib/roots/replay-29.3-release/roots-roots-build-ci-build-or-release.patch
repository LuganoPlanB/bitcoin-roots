diff --git a/.github/actions/setup-windows-gui-tools/action.yml b/.github/actions/setup-windows-gui-tools/action.yml
new file mode 100644
index 0000000000000000000000000000000000000000..0d9da5fe9f6b74f856c6da7afaf638b41c5bbbd2
--- /dev/null
+++ b/.github/actions/setup-windows-gui-tools/action.yml
@@ -0,0 +1,32 @@
+name: 'Set up Windows GUI asset tools'
+description: 'Install and locate the SVG and image converters required by the Qt build'
+runs:
+  using: 'composite'
+  steps:
+    - name: Install GUI asset tools
+      shell: pwsh
+      run: |
+        $ErrorActionPreference = 'Stop'
+        $validExitCodes = @(0, 1641, 3010)
+
+        choco install rsvg-convert --version=2.40.20 --yes --no-progress
+        if ($validExitCodes -notcontains $LASTEXITCODE) {
+          throw "Chocolatey failed to install rsvg-convert (exit code $LASTEXITCODE)"
+        }
+
+        choco install imagemagick --version=7.1.2.2500 --yes --no-progress
+        if ($validExitCodes -notcontains $LASTEXITCODE) {
+          throw "Chocolatey failed to install ImageMagick (exit code $LASTEXITCODE)"
+        }
+
+        $machinePath = [Environment]::GetEnvironmentVariable('Path', 'Machine')
+        $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
+        $env:Path = "$machinePath;$userPath;$env:Path"
+
+        $rsvgConvert = (Get-Command rsvg-convert.exe -ErrorAction Stop).Source
+        $imagemagickConvert = (Get-Command magick.exe -ErrorAction Stop).Source
+        & $rsvgConvert --version
+        & $imagemagickConvert -version
+
+        "RSVG_CONVERT=$rsvgConvert" >> $env:GITHUB_ENV
+        "IMAGEMAGICK_CONVERT=$imagemagickConvert" >> $env:GITHUB_ENV
