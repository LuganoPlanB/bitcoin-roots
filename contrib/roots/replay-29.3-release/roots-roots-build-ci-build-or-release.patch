+
+export LC_ALL=C
+set -Eeuo pipefail
+
+if [[ "$#" -ne 1 ]]; then
+    printf 'Usage: %s RELEASE_TAG\n' "$0" >&2
+    exit 2
+fi
+
+release_tag=$1
+if [[ ! "$release_tag" =~ ^v[0-9]+\.[0-9]+(\.[0-9]+)?([-+][0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$ ]]; then
