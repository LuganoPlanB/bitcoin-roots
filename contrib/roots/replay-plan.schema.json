{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bitcoin Roots offline replay plan",
  "type": "object",
  "required": ["schema_version", "tool", "input", "operations", "replay_state", "digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"const": "roots-replay"},
    "operations": {"const": ["verify", "plan"]},
    "replay_state": {"const": "not-created"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {
      "type": "object",
      "required": ["schema_version", "revision", "tree", "repository_snapshot"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_snapshot": {"type": "object"}
      }
    }
  }
}
