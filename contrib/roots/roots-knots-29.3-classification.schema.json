{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_digest": {"pattern": "^sha1:[0-9a-f]{40}$", "type": "string"},
    "records": {"minItems": 1, "type": "array"},
    "schema_version": {"const": 1},
    "scope": {"type": "string"}
  },
  "required": ["schema_version", "evidence_digest", "records", "scope"],
  "type": "object"
}
