{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bitcoin Roots replay materials",
  "type": "object",
  "required": ["schema_version", "materials"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "minimum_tool_version", "features"],
      "properties": {
        "tool": {"const": "roots-replay"},
        "minimum_tool_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mechanism"],
        "properties": {"mechanism": {"enum": ["commit", "patch", "module/data", "generator", "manual"]}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": 1}}}, "then": {"not": {"required": ["contract"]}}},
    {"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["contract"]}}
  ]
}
