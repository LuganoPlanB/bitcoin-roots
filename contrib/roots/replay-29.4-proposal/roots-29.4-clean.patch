+        struct evutil_addrinfo hints = {};
+        int ai_result;
+
+        hints.ai_family = AF_UNSPEC;
+        hints.ai_socktype = SOCK_STREAM;
+        hints.ai_flags = EVUTIL_AI_PASSIVE|EVUTIL_AI_ADDRCONFIG;
+        const std::string strport = strprintf("%d", port);
