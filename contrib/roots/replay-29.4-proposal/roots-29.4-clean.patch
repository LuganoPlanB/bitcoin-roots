+        Assert(model->node().context()->validation_signals);
+        m_validation_interface = new NetWatchValidationInterface(*this);
+        model->node().context()->validation_signals->RegisterValidationInterface(m_validation_interface);
+    }
+    updateDisplayUnit();
+}
