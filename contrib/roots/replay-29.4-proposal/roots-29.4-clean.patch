+  }
+
+  .roots-close {
+    grid-template-columns: 1fr;
+  }
+
+  .roots-close img {
+    width: 4rem;
+  }
+
+  .roots-close > .roots-actions {
+    grid-column: 1;
+  }
+
+  .roots-comparison-table {
+    margin-right: calc(var(--roots-gutter) * -1);
+  }
+
+  .roots-comparison-table__hint {
+    padding-right: var(--roots-gutter);
+  }
+
+  .roots-comparison-table table {
+    min-width: 58rem;
+  }
+
+  .roots-atlas__header {
+    grid-template-columns: 1fr;
+    gap: 1.5rem;
+  }
+
+  .roots-atlas__count {
+    white-space: normal;
+  }
+
+  .roots-atlas__groups {
+    gap: 3.5rem;
+  }
+}
+
+@media (max-width: 420px) {
+  .roots-actions {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .roots-action {
+    width: 100%;
+  }
+
+  .roots-start__path li {
+    grid-template-columns: 1fr;
+    gap: 0.55rem;
+  }
+
+  .roots-close .roots-actions {
