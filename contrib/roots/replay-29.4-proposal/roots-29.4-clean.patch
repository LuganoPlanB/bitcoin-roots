+  }
+
+  .roots-boundary__connector span {
+    margin: 1.38rem 0 0 -0.34rem;
+  }
+
+  .roots-library__routes,
+  .roots-atlas__groups {
+    grid-template-columns: 1fr;
+  }
+
+  .roots-library__routes a:nth-child(odd) {
