+bool ScalingGraphicsView::viewportEvent(QEvent * const event)
+{
+    if (event->type() == QEvent::ToolTip) {
+        // causes QGraphicsScene to destroy our tooltips, so block it here
+        return true;
+    }
+    return QGraphicsView::viewportEvent(event);
+}
