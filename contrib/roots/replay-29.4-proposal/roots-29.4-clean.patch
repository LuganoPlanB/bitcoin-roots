+        if (version != MEMPOOL_KNOTS_DUMP_VERSION) {
+            return false;
+        }
+
+        const unsigned int priority_deltas_count = ReadCompactSize(file);
+        uint256 txid;
+        uint64_t encoded_priority;
+        for (unsigned int i = 0; i < priority_deltas_count; ++i) {
