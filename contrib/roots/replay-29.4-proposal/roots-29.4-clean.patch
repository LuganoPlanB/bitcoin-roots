+bool LoadMempoolKnots(CTxMemPool& pool, const fs::path& knots_filepath, FopenFn mockable_fopen_function)
+{
+    AutoFile file{mockable_fopen_function(knots_filepath, "rb")};
+    if (file.IsNull()) {
+        // Typically missing if there's nothing to save
+        return false;
+    }
