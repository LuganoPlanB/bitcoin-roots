+        QString text = label->text();
+
+        if (!label->isHidden()) {
+            if (i == 1) {
+                html += "<b>" + text + "</b><br>";
+            } else if (i % 2 == 0) {
+                assert(text.endsWith(":"));
+                text.chop(1);
+                html += "<b>" + text + "</b>: ";
+            } else {
+                html += text + "<br>";
+            }
+        }
+    }
+    html += "</font></html>";
