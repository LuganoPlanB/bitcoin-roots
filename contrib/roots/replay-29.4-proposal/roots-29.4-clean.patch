+
+  macos-native-release:
+    name: ${{ matrix.name }}
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 180
+    env:
+      DANGER_RUN_CI_ON_HOST: 1
+      BASE_ROOT_DIR: ${{ github.workspace }}
+      RUN_UNIT_TESTS: 'false'
+      RUN_FUNCTIONAL_TESTS: 'false'
+      RUN_FUZZ_TESTS: 'false'
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - name: 'macOS 15 native, x86_64 release'
+            runner: macos-15-intel
+            expected-arch: x86_64
+            artifact-name: bitcoin-roots-darwin-x86_64
+          - name: 'macOS 15 native, arm64 release'
+            runner: macos-15
+            expected-arch: arm64
+            artifact-name: bitcoin-roots-darwin-arm64
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Verify architecture and select Xcode 16
+        env:
+          EXPECTED_ARCH: ${{ matrix.expected-arch }}
+        run: |
+          set -euo pipefail
+          actual_arch="$(uname -m)"
+          if [[ "${actual_arch}" != "${EXPECTED_ARCH}" ]]; then
+            echo "Expected ${EXPECTED_ARCH}, but runner reported ${actual_arch}" >&2
+            exit 1
+          fi
+          sudo xcode-select --switch /Applications/Xcode_16.0.app
+
+      - name: Install Homebrew packages
+        env:
+          HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK: 1
+        run: |
+          brew install --quiet python@3 || brew link --overwrite python@3
+          brew install --quiet coreutils ninja pkgconf gnu-getopt ccache boost libevent miniupnpc zeromq qt@5 qrencode imagemagick libicns librsvg
+
+      - name: Set compiler cache directory
+        run: echo "CCACHE_DIR=${RUNNER_TEMP}/ccache_dir" >> "$GITHUB_ENV"
+
+      - name: Restore compiler cache
+        uses: hendrikmuhs/ccache-action@f09c25b45002a07be2955cbe52e8cee55643f89d # v1.2.24
+        with:
+          install: no
+          key: macos-${{ matrix.expected-arch }}-appleclang-release-gui
+          restore-keys: macos-${{ matrix.expected-arch }}-appleclang-release-gui
+          max-size: 500M
+          append-timestamp: true
+          save: ${{ (github.event_name == 'push' || github.event_name == 'workflow_dispatch') && github.ref_name == github.event.repository.default_branch }}
+
+      - name: Build release package
+        run: ./ci/test_run_all.sh
+        env:
+          FILE_ENV: './ci/test/00_setup_env_mac_native.sh'
+
+      - name: Stage release package
+        env:
+          ARTIFACT_NAME: ${{ matrix.artifact-name }}
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          packages=("${GITHUB_WORKSPACE}"/ci/scratch/build-*/*.zip)
+          if (( ${#packages[@]} != 1 )); then
+            echo "Expected one macOS release package, found ${#packages[@]}" >&2
+            exit 1
+          fi
+          platform_name="bitcoin-roots-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | tr '[:upper:]' '[:lower:]')"
+          if [[ "${platform_name}" != "${ARTIFACT_NAME}" ]]; then
+            echo "Expected platform name ${ARTIFACT_NAME}, found ${platform_name}" >&2
+            exit 1
+          fi
+          package_dir="${RUNNER_TEMP}/release-packages"
+          archive_root="$(python3 ci/release/archive.py root-name)"
+          staging_parent="$(mktemp -d "${RUNNER_TEMP}/release-package.XXXXXX")"
+          trap 'rm -rf -- "${staging_parent}"' EXIT
+          mkdir -p "${staging_parent}/${archive_root}"
+          unzip -q "${packages[0]}" -d "${staging_parent}/${archive_root}"
+          mkdir -p "${package_dir}"
+          archive="${package_dir}/${ARTIFACT_NAME}.zip"
+          (
+            cd "${staging_parent}"
+            zip -qry "${archive}" "${archive_root}"
+          )
+          python3 ci/release/archive.py validate "${archive}" "${archive_root}"
+          (
+            cd "${package_dir}"
+            shasum -a 256 "${ARTIFACT_NAME}.zip" > SHA256SUMS
+          )
+
+      - name: Upload unsigned release package
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.artifact-name }}-${{ github.sha }}
+          path: ${{ runner.temp }}/release-packages/
+          if-no-files-found: error
+          retention-days: 30
+
+  publish-release:
+    name: 'Publish signed draft release'
+    if: startsWith(github.ref, 'refs/tags/v')
+    needs:
+      - release-metadata-tests
+      - linux-release
+      - windows-x86_64-release
+      - macos-native-release
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      actions: read
+      contents: write
+    env:
+      EXPECTED_FINGERPRINT: '5EADD53F2CD1F0B7AEEE920D25FC5C29CD528E32'
+      EXPECTED_PACKAGE_COUNT: '5'
+      PUBLIC_KEY_FILE: 'contrib/release/bitcoin-roots-release-key.asc'
+    steps:
+      - name: Checkout release tag
+        uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      - name: Verify tag commit is on main
+        run: |
+          set -Eeuo pipefail
+          git fetch --no-tags origin main:refs/remotes/origin/main
+          tag_commit="$(git rev-list -n 1 "$GITHUB_REF_NAME")"
+          if ! git merge-base --is-ancestor "$tag_commit" origin/main; then
+            printf 'Release tag %s does not point to a commit on main\n' "$GITHUB_REF_NAME" >&2
+            exit 1
+          fi
+
+      - name: Download release artifacts
+        uses: actions/download-artifact@v5
+        with:
+          pattern: bitcoin-roots-*-${{ github.sha }}
+          path: downloaded-artifacts
+
+      - name: Prepare release assets and SHA-512 manifest
+        run: |
+          ci/release/prepare-release.sh \
+            downloaded-artifacts \
+            release-assets \
+            "$PUBLIC_KEY_FILE" \
+            "$GITHUB_REF_NAME" \
+            "$EXPECTED_PACKAGE_COUNT"
+
+      - name: Sign and verify SHA-512 manifest
+        env:
+          BITCOIN_ROOTS_GPG_SK: ${{ secrets.BITCOIN_ROOTS_GPG_SK }}
+        run: |
+          set -Eeuo pipefail
+          if [[ -z "${BITCOIN_ROOTS_GPG_SK:-}" ]]; then
+            printf 'BITCOIN_ROOTS_GPG_SK is not configured\n' >&2
+            exit 1
+          fi
+
+          gpg_home="${RUNNER_TEMP}/bitcoin-roots-release-gpg"
+          install -d -m 0700 "$gpg_home"
+          trap 'rm -rf -- "$gpg_home"' EXIT
+          export GNUPGHOME="$gpg_home"
+
+          public_fingerprint="$(
+            gpg --batch --with-colons --import-options show-only --import "$PUBLIC_KEY_FILE" |
+              awk -F: '$1 == "fpr" { print $10; exit }'
+          )"
+          if [[ "$public_fingerprint" != "$EXPECTED_FINGERPRINT" ]]; then
+            printf 'Unexpected release public-key fingerprint: %s\n' "$public_fingerprint" >&2
+            exit 1
+          fi
+
+          printf '%s\n' "$BITCOIN_ROOTS_GPG_SK" | gpg --batch --import
+          secret_fingerprint="$(
+            gpg --batch --with-colons --list-secret-keys "$EXPECTED_FINGERPRINT" |
+              awk -F: '$1 == "fpr" { print $10; exit }'
+          )"
+          if [[ "$secret_fingerprint" != "$EXPECTED_FINGERPRINT" ]]; then
+            printf 'The configured secret key does not match the release public key\n' >&2
+            exit 1
+          fi
+
+          gpg --batch --yes --armor \
+            --local-user "$EXPECTED_FINGERPRINT" \
+            --output release-assets/SHA512SUMS.asc \
+            --detach-sign release-assets/SHA512SUMS
+          gpg --batch --verify release-assets/SHA512SUMS.asc release-assets/SHA512SUMS
+
+      - name: Create draft GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -Eeuo pipefail
+          shopt -s nullglob
+          release_options=(
+            --draft
+            --generate-notes
+            --title "Bitcoin Roots ${GITHUB_REF_NAME}"
+            --verify-tag
+          )
+          if [[ "$GITHUB_REF_NAME" == *-rc* ]]; then
+            release_options+=(--prerelease)
+          fi
+          release_assets=(release-assets/*)
+          if [[ "${#release_assets[@]}" -ne "$((EXPECTED_PACKAGE_COUNT + 2))" ]]; then
+            printf 'Expected %s release assets, found %s\n' \
+              "$((EXPECTED_PACKAGE_COUNT + 2))" "${#release_assets[@]}" >&2
+            exit 1
+          fi
+          gh release create "$GITHUB_REF_NAME" \
+            "${release_options[@]}" \
+            "${release_assets[@]}"
