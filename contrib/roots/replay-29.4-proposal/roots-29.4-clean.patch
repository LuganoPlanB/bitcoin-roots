+my_bind_socket_with_handle(struct evhttp *http, const char *address, ev_uint16_t port, bool& ignorable_error)
+{
+    evutil_socket_t fd;
+    struct evhttp_bound_socket *bound;
+    int serrno;
+
+    struct evutil_addrinfo *aitop = nullptr;
+
+    if (address == nullptr && port == 0) {
