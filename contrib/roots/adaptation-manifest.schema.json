{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bitcoin Roots logical adaptation manifest",
  "type": "object",
  "required": ["schema_version", "atlas_report_digest", "units"],
  "properties": {
    "schema_version": {"const": 1},
    "atlas_report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "additionalProperties": false,
  "$defs": {
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenance": {
      "type": "object", "required": ["project", "commit", "confidence"], "additionalProperties": false,
      "properties": {
        "project": {"enum": ["bitcoin-core", "bitcoin-knots", "bitcoin-roots"]},
        "commit": {"type": "string", "pattern": "^sha1:[0-9a-f]{40}$"},
        "confidence": {"enum": ["verified", "reviewed", "inferred"]}
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "owner_area", "purpose", "provenance", "license", "original_patch_ids", "current_patch_ids", "layer", "dependencies", "conflicts", "touched", "generated", "risk_tier", "consensus_policy_effect", "supported_release_range", "application", "required_tests", "upstream_disposition", "retirement_conditions", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^roots-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "owner_area": {"enum": ["build", "compatibility", "documentation", "gui", "identity", "network", "policy", "tests", "tooling", "wallet"]},
        "purpose": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "license": {"type": "object", "required": ["compatible", "evidence"], "additionalProperties": false, "properties": {"compatible": {"const": true}, "evidence": {"type": "string", "minLength": 1}}},
        "original_patch_ids": {"$ref": "#/$defs/string_list"},
        "current_patch_ids": {"$ref": "#/$defs/string_list"},
        "layer": {"enum": ["knots-inherited", "roots-owned"]},
        "dependencies": {"$ref": "#/$defs/string_list"},
        "conflicts": {"$ref": "#/$defs/string_list"},
        "provides": {"$ref": "#/$defs/string_list"},
        "conditions": {"type": "object", "required": ["release_tags", "replaces"], "additionalProperties": false, "properties": {"release_tags": {"$ref": "#/$defs/string_list"}, "replaces": {"$ref": "#/$defs/string_list"}}},
        "phase": {"enum": ["foundation", "module", "behavior", "ui-branding", "tests", "generated", "release-metadata"]},
        "touched": {"type": "object", "required": ["targets", "paths"], "additionalProperties": false, "properties": {"targets": {"$ref": "#/$defs/string_list"}, "paths": {"$ref": "#/$defs/string_list"}}},
        "generated": {"type": "object", "required": ["inputs", "outputs"], "additionalProperties": false, "properties": {"inputs": {"$ref": "#/$defs/string_list"}, "outputs": {"$ref": "#/$defs/string_list"}}},
        "risk_tier": {"enum": ["low", "medium", "high", "critical"]},
        "consensus_policy_effect": {"enum": ["consensus-neutral", "policy-only", "consensus-sensitive", "unknown"]},
        "supported_release_range": {"type": "object", "required": ["from", "through"], "additionalProperties": false, "properties": {"from": {"type": "string", "minLength": 1}, "through": {"type": "string", "minLength": 1}}},
        "application": {"type": "object", "required": ["mechanism", "reference"], "additionalProperties": false, "properties": {"mechanism": {"enum": ["commit", "patch", "module/data", "generator", "manual"]}, "reference": {"type": "string", "minLength": 1}}},
        "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "upstream_disposition": {"type": "object", "required": ["status", "evidence"], "additionalProperties": false, "properties": {"status": {"enum": ["roots-only", "candidate", "submitted", "absorbed", "not-applicable"]}, "evidence": {"type": "string", "minLength": 1}}},
        "retirement_conditions": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["active", "absorbed", "obsolete", "rejected"]}
      }
    }
  }
}
