{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "base_tag", "base_commit", "target_commit", "target_tree", "aggregate_diff_digest", "manifest_owned_diff_digest", "commit_map"],
  "properties": {
    "schema_version": {"const": 1},
    "base_tag": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^sha1:[0-9a-f]{40}$"},
    "target_commit": {"type": "string", "pattern": "^sha1:[0-9a-f]{40}$"},
    "target_tree": {"type": "string", "pattern": "^sha1:[0-9a-f]{40}$"},
    "aggregate_diff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_owned_diff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit_map": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
