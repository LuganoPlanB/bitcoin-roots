{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "input_digests", "target_commit", "target_scoped_tree_digest", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "input_digests": {"type": "object"},
    "target_commit": {"type": "string", "pattern": "^sha1:[0-9a-f]{40}$"},
    "target_scoped_tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array"}
  },
  "additionalProperties": false
}
