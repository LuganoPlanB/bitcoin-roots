# Independent GUI HTTP/TLS and local public metadata source dependencies.
function(roots_gui_add_service_dependencies source_dir)
  # Native reviewed password/KDF/authenticated-file provider. No runtime fetch.
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(ROOTS_GUI_SODIUM REQUIRED IMPORTED_TARGET libsodium>=1.0.18)
  set(BUILD_CURL_EXE OFF)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_STATIC_LIBS ON)
  set(BUILD_TESTING OFF)
  set(BUILD_EXAMPLES OFF)
  set(BUILD_LIBCURL_DOCS OFF)
  set(BUILD_MISC_DOCS OFF)
  set(ENABLE_CURL_MANUAL OFF)
  set(CURL_DISABLE_INSTALL ON)
  set(CURL_ENABLE_EXPORT_TARGET OFF)
  foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMTP
      TELNET TFTP WEBSOCKETS IPFS)
    set(CURL_DISABLE_${protocol} ON)
  endforeach()
  set(CURL_ENABLE_SSL ON)
  set(CURL_USE_OPENSSL ON)
  foreach(feature CURL_ZLIB CURL_BROTLI CURL_ZSTD USE_NGHTTP2 CURL_USE_LIBPSL
      CURL_USE_LIBSSH2 CURL_USE_LIBSSH CURL_USE_GSSAPI CURL_USE_LIBIDN2)
    set(${feature} OFF)
  endforeach()
  add_subdirectory("${source_dir}/curl" "${CMAKE_CURRENT_BINARY_DIR}/curl" EXCLUDE_FROM_ALL)
  add_library(roots_gui_http INTERFACE)
  target_link_libraries(roots_gui_http INTERFACE CURL::libcurl_static)
  add_library(roots_gui_sqlite STATIC "${source_dir}/sqlite/sqlite3.c")
  target_include_directories(roots_gui_sqlite PUBLIC "${source_dir}/sqlite")
  target_compile_definitions(roots_gui_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION)
  find_package(Threads REQUIRED)
  target_link_libraries(roots_gui_sqlite PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
  if(UNIX)
    target_link_libraries(roots_gui_sqlite PRIVATE m)
  endif()
endfunction()
