# Local source-only integration. No FetchContent, downloads, Core or Qt targets.
function(roots_gui_add_ui_dependencies source_dir)
  if(TARGET roots_gui_imgui OR TARGET imkit::imkit)
    message(FATAL_ERROR "roots-gui UI dependencies must be added exactly once")
  endif()
  add_library(roots_gui_imgui STATIC
    "${source_dir}/imgui/imgui.cpp" "${source_dir}/imgui/imgui_draw.cpp"
    "${source_dir}/imgui/imgui_tables.cpp" "${source_dir}/imgui/imgui_widgets.cpp")
  target_include_directories(roots_gui_imgui PUBLIC "${source_dir}/imgui")
  target_compile_features(roots_gui_imgui PUBLIC cxx_std_20)
  # One target owns core sources and the unmodified imconfig.h for all consumers.
  set(IMKIT_IMGUI_TARGET roots_gui_imgui)
  add_library(roots_gui_imkit STATIC)
  foreach(unit widgets theme theme_text decor components icons accessibility patterns
      workflow toast charts range_slider ptz shell window_frame)
    target_sources(roots_gui_imkit PRIVATE "${source_dir}/imkit/src/${unit}.cpp")
  endforeach()
  add_library(imkit::imkit ALIAS roots_gui_imkit)
  target_include_directories(roots_gui_imkit PUBLIC "${source_dir}/imkit/include")
  target_compile_features(roots_gui_imkit PUBLIC cxx_std_20)
  target_link_libraries(roots_gui_imkit PUBLIC ${IMKIT_IMGUI_TARGET})

  set(GLFW_BUILD_DOCS OFF)
  set(GLFW_BUILD_TESTS OFF)
  set(GLFW_BUILD_EXAMPLES OFF)
  set(GLFW_INSTALL OFF)
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # Real X11 backend. Wayland requires a separate capability qualification.
    set(GLFW_BUILD_X11 ON)
    set(GLFW_BUILD_WAYLAND OFF)
    foreach(extension Xrandr Xinerama Xcursor Xi Xfixes)
      set(X11_${extension}_INCLUDE_PATH "${source_dir}/x11/include")
    endforeach()
  endif()
  add_subdirectory("${source_dir}/glfw" "${CMAKE_CURRENT_BINARY_DIR}/glfw" EXCLUDE_FROM_ALL)
  add_library(roots_gui_backends STATIC "${source_dir}/imgui/backends/imgui_impl_glfw.cpp")
  target_include_directories(roots_gui_backends PUBLIC "${source_dir}/imgui/backends")
  target_link_libraries(roots_gui_backends PUBLIC roots_gui_imgui glfw)
  if(APPLE)
    # Follow-on source branch; no macOS qualification is implied on Linux.
    enable_language(OBJCXX)
    target_sources(roots_gui_backends PRIVATE "${source_dir}/imgui/backends/imgui_impl_metal.mm")
    target_link_libraries(roots_gui_backends PUBLIC "-framework Cocoa" "-framework Metal" "-framework MetalKit" "-framework QuartzCore")
  elseif(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(OpenGL REQUIRED)
    target_sources(roots_gui_backends PRIVATE "${source_dir}/imgui/backends/imgui_impl_opengl3.cpp")
    target_link_libraries(roots_gui_backends PUBLIC OpenGL::GL)
  else()
    message(FATAL_ERROR "roots-gui host has not been qualified for this platform")
  endif()
endfunction()
