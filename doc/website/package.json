{
  "name": "bitcoin-roots-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "releases:prepare": "node scripts/prepare-releases.mjs",
    "releases:build": "npm run releases:prepare && npm run build",
    "patches:render": "node scripts/render-patches.mjs",
    "patches:check": "node scripts/check-patch-html.mjs",
    "patches:smoke": "node scripts/check-patch-browser.mjs",
    "docs:prepare": "node scripts/generate-doc-catalog.mjs",
    "dev": "npm run docs:prepare && vitepress dev",
    "build": "npm run docs:prepare && vitepress build && npm run patches:render && npm run patches:check && node scripts/check-static-html.mjs",
    "preview": "vitepress preview",
    "test": "npm run docs:prepare && node --test .vitepress/tests/*.test.mjs"
  },
  "dependencies": {
    "diff2html": "3.4.56",
    "lugano-planb-vite-theme": "file:../../../vite-theme"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "vitepress": "1.6.4",
    "vue": "3.5.21"
  }
}
